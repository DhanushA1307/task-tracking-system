# ==============================================================================
# Task Tracking System — Backend Environment Template
# Copy this file to .env and fill in your environment-specific credentials.
# ==============================================================================

# --- Application ---
PROJECT_NAME=Task Tracking System
API_V1_STR=/api
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL Database ---
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/task_tracking_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=task_tracking_db
PGUSER=postgres
PGPASSWORD=your_password

# Cloud PostgreSQL (Supabase) example:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-DATABASE-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Vercel IPv4 Session Pooler example:
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:[YOUR-DATABASE-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=replace-with-64-char-random-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS & Frontend Origins ---
FRONTEND_URL=https://your-app.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
